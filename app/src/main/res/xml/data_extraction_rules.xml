<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="elsewhere.db" />
        <include domain="file" path="photos/thumbs/" />
        <exclude domain="file" path="photos/originals/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="elsewhere.db" />
        <include domain="file" path="photos/" />
    </device-transfer>
</data-extraction-rules>
